/**
 * Worker configuration: https://developers.cloudflare.com/workers/wrangler/configuration/
 *
 * Set secrets with `pnpm exec wrangler secret put <NAME>`:
 * SOUNDCLOUD_CLIENT_ID, SOUNDCLOUD_CLIENT_SECRET, COOKIE_ENCRYPTION_KEY.
 * ALLOWED_USERS is an optional comma-separated account allowlist.
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "soundcloud-mcp",
	"main": "src/worker.ts",
	"compatibility_date": "2026-09-11",
	"compatibility_flags": ["nodejs_compat"],
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["SoundCloudMCP"]
		},
		{
			"tag": "v2",
			"deleted_classes": ["SoundCloudMCP"]
		}
	],
	"workers_dev": true,
	"kv_namespaces": [
		{
			"binding": "OAUTH_KV",
			"id": "a83aa5f11ccb44009d83f87731b522ff"
		}
	],
	"observability": {
		"enabled": true
	},
	"dev": {
		"port": 8789
	}
}
