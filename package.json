{
	"name": "soundcloud-mcp",
	"version": "1.1.2",
	"description": "SoundCloud MCP server for stdio and Cloudflare Workers",
	"type": "module",
	"main": "build/index.js",
	"scripts": {
		"build": "tsc -p tsconfig.build.json && node -e \"['index','stdio/auth'].forEach(f=>require('fs').chmodSync('build/'+f+'.js','755'))\"",
		"start": "node --env-file-if-exists=.env build/index.js",
		"auth": "pnpm build && node --env-file-if-exists=.env build/stdio/auth.js",
		"dev": "tsc -p tsconfig.build.json --watch",
		"typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
		"test": "vitest run && vitest run --config vitest.workerd.config.ts",
		"test:watch": "vitest",
		"lint": "biome check .",
		"lint:md": "markdownlint-cli2 \"*.md\"",
		"format": "biome check --write .",
		"check": "pnpm lint && pnpm lint:md && pnpm typecheck && pnpm test",
		"verify": "pnpm build && node scripts/verify.mjs",
		"worker:dev": "wrangler dev",
		"worker:deploy": "wrangler deploy",
		"inspector": "pnpm build && pnpm dlx @modelcontextprotocol/inspector node --env-file-if-exists=.env build/index.js"
	},
	"keywords": [
		"mcp",
		"soundcloud",
		"api"
	],
	"author": "",
	"license": "MIT",
	"packageManager": "pnpm@11.21.0",
	"engines": {
		"node": "^22.18.0 || >=24.11.0"
	},
	"dependencies": {
		"@cloudflare/workers-oauth-provider": "^1.2.4",
		"@modelcontextprotocol/server": "2.4.0",
		"agents": "^0.33.0",
		"hono": "^4.13.18",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.7",
		"@cloudflare/vitest-plugin": "^1.8.0",
		"@cloudflare/workers-types": "^5.20261112.1",
		"@modelcontextprotocol/client": "2.4.0",
		"@types/node": "^22.20.5",
		"markdownlint-cli2": "^0.24.1",
		"typescript": "^7.0.2",
		"vitest": "^5.1.0",
		"wrangler": "^4.160.1"
	}
}
