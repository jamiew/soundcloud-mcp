{
  "name": "soundcloud-mcp",
  "version": "1.0.0",
  "description": "MCP server for SoundCloud",
  "type": "module",
  "main": "build/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"['index','auth'].forEach(f=>require('fs').chmodSync('build/'+f+'.js','755'))\"",
    "start": "node --env-file-if-exists=.env build/index.js",
    "auth": "npm run build && node --env-file-if-exists=.env build/auth.js",
    "dev": "tsc -w",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check src",
    "format": "biome check --write src",
    "inspector": "npm run build && npx @modelcontextprotocol/inspector node --env-file-if-exists=.env build/index.js"
  },
  "keywords": [
    "mcp",
    "soundcloud",
    "api"
  ],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.1",
    "@types/node": "^22.10.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
