{
	"name": "@jamiew/soundcloud-mcp",
	"version": "1.2.0",
	"description": "Unofficial SoundCloud MCP server for stdio and Cloudflare Workers",
	"mcpName": "io.github.jamiew/soundcloud-mcp",
	"type": "module",
	"main": "build/index.js",
	"bin": {
		"soundcloud-mcp": "build/index.js",
		"soundcloud-mcp-auth": "build/stdio/auth.js"
	},
	"files": [
		"build"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json && node -e \"['index','stdio/auth'].forEach(f=>require('fs').chmodSync('build/'+f+'.js','755'))\"",
		"start": "node --env-file-if-exists=.env build/index.js",
		"auth": "pnpm build && node --env-file-if-exists=.env build/stdio/auth.js",
		"dev": "tsc -p tsconfig.build.json --watch",
		"typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
		"test": "vitest run && vitest run --config vitest.workerd.config.ts",
		"test:watch": "vitest",
		"lint": "biome check .",
		"lint:md": "markdownlint-cli2 \"*.md\"",
		"format": "biome check --write .",
		"check": "pnpm lint && pnpm lint:md && pnpm typecheck && pnpm test",
		"prepublishOnly": "pnpm build",
		"verify": "pnpm build && node scripts/verify.mjs",
		"worker:dev": "wrangler dev",
		"worker:deploy": "wrangler deploy",
		"inspector": "pnpm build && pnpm dlx @modelcontextprotocol/inspector node --env-file-if-exists=.env build/index.js"
	},
	"keywords": [
		"mcp",
		"soundcloud",
		"api"
	],
	"author": "Jamie Dubs",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jamiew/soundcloud-mcp.git"
	},
	"homepage": "https://github.com/jamiew/soundcloud-mcp#readme",
	"bugs": "https://github.com/jamiew/soundcloud-mcp/issues",
	"packageManager": "pnpm@11.21.0",
	"engines": {
		"node": "^22.18.0 || >=24.11.0"
	},
	"dependencies": {
		"@modelcontextprotocol/server": "2.4.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.9",
		"@cloudflare/vitest-plugin": "^1.9.2",
		"@cloudflare/workers-oauth-provider": "^1.4.0",
		"@cloudflare/workers-types": "^5.20261125.1",
		"@modelcontextprotocol/client": "2.4.0",
		"@types/node": "^22.20.7",
		"agents": "^0.34.1",
		"hono": "^4.13.23",
		"markdownlint-cli2": "^0.24.2",
		"typescript": "^7.0.2",
		"vitest": "^5.1.2",
		"wrangler": "^4.168.0"
	}
}
