{
  "name": "soundcloud-mcp",
  "version": "1.0.0",
  "description": "MCP server for SoundCloud",
  "type": "module",
  "main": "build/index.js",
  "scripts": {
    "build": "tsc && node -e \"['index','auth'].forEach(f=>require('fs').chmodSync('build/'+f+'.js','755'))\"",
    "start": "node -r dotenv/config build/index.js",
    "auth": "npm run build && node -r dotenv/config build/auth.js",
    "dev": "tsc -w",
    "inspector": "npm run build && npx @modelcontextprotocol/inspector node -r dotenv/config build/index.js"
  },
  "keywords": [
    "mcp",
    "soundcloud",
    "api"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.2.0",
    "dotenv": "^16.3.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3"
  }
}
