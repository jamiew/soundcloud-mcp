{
	"name": "soundcloud-mcp",
	"version": "1.0.0",
	"description": "MCP server for SoundCloud — stdio and Cloudflare Workers",
	"type": "module",
	"main": "build/index.js",
	"scripts": {
		"build": "tsc -p tsconfig.build.json && node -e \"['index','stdio/auth'].forEach(f=>require('fs').chmodSync('build/'+f+'.js','755'))\"",
		"start": "node --env-file-if-exists=.env build/index.js",
		"auth": "pnpm build && node --env-file-if-exists=.env build/stdio/auth.js",
		"dev": "tsc -w",
		"typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "biome check .",
		"lint:md": "markdownlint-cli2 \"*.md\"",
		"format": "biome check --write .",
		"check": "pnpm lint && pnpm lint:md && pnpm typecheck && pnpm test",
		"verify": "pnpm build && node scripts/verify.mjs",
		"worker:dev": "wrangler dev",
		"worker:deploy": "wrangler deploy",
		"worker:typegen": "wrangler types",
		"inspector": "pnpm build && pnpm dlx @modelcontextprotocol/inspector node --env-file-if-exists=.env build/index.js"
	},
	"keywords": [
		"mcp",
		"soundcloud",
		"api"
	],
	"author": "",
	"license": "ISC",
	"engines": {
		"node": ">=22"
	},
	"dependencies": {
		"@cloudflare/workers-oauth-provider": "^0.8.1",
		"@modelcontextprotocol/sdk": "^1.29.0",
		"agents": "^0.17.1",
		"hono": "^4.12.27",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.5",
		"@cloudflare/workers-types": "^4.20260628.1",
		"@types/node": "^22.10.0",
		"markdownlint-cli2": "^0.23.1",
		"typescript": "^6.0.3",
		"vitest": "^4.1.10",
		"wrangler": "^4.105.0"
	}
}
