# SoundCloud OAuth — get these from https://soundcloud.com/you/apps
SOUNDCLOUD_CLIENT_ID=your_client_id_here
SOUNDCLOUD_CLIENT_SECRET=your_client_secret_here

# Must match the Redirect URI in your SoundCloud app settings exactly
SOUNDCLOUD_REDIRECT_URI=http://localhost:8888/callback

# Optional: where user OAuth tokens are stored (default: ~/.soundcloud-mcp/tokens.json)
# SOUNDCLOUD_TOKEN_FILE=~/.soundcloud-mcp/tokens.json

# Optional: verbose request logging to stderr
# MCP_DEBUG=true
