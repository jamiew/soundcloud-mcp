// Node and Workers need separate global types.
{
	"compilerOptions": {
		"target": "ES2023",
		"lib": ["ES2023"],
		"types": ["node"],
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"outDir": "./build",
		"rootDir": "./src",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true
	},
	"include": ["src/**/*"],
	"exclude": ["node_modules", "src/worker.ts", "src/worker/**"]
}
